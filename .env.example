# 公開唯讀 Supabase 設定
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 後台寫入開關
CMS_WRITE_ENABLED=false

# AI 文章優化（只可設於伺服器環境）
CONTENT_AI_ENABLED=false
# 預設使用 Gemini 直連；金鑰只能存於 Vercel Sensitive 環境變數。
CONTENT_AI_PROVIDER=google
GEMINI_API_KEY=
# 只有切回 gateway 備援時才需要 AI_GATEWAY_API_KEY 或 Vercel OIDC。
AI_GATEWAY_API_KEY=
CONTENT_AI_MODEL=gemini-2.5-flash
CONTENT_AI_PROMPT_VERSION=2026-09-15-v1

# 正式網域與索引控制
SITE_CANONICAL_URL=https://huayi.tw
# Preview 不得設為 true；僅在正式環境需要手動覆寫時使用。
SITE_ALLOW_INDEXING=false
