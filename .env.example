# 公開唯讀 Supabase 設定
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 後台寫入開關
CMS_WRITE_ENABLED=false

# AI 文章優化（只可設於伺服器環境）
CONTENT_AI_ENABLED=false
# Vercel 部署使用自動輪替的 OIDC，不需保存 OpenAI 金鑰。
# 本機開發若無 OIDC，才使用伺服器端 AI_GATEWAY_API_KEY。
AI_GATEWAY_API_KEY=
CONTENT_AI_MODEL=openai/gpt-5.6-sol
CONTENT_AI_PROMPT_VERSION=2026-09-15-v1

# 正式網域與索引控制
SITE_CANONICAL_URL=https://huayi.tw
# Preview 不得設為 true；僅在正式環境需要手動覆寫時使用。
SITE_ALLOW_INDEXING=false
